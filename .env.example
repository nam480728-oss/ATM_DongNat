# Kết nối MySQL/MariaDB (database atm_db)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/atm_db?charset=utf8mb4

# Khóa bí mật Flask (đổi thành chuỗi ngẫu nhiên)
SECRET_KEY=change-me

# Mật khẩu trang /admin
ADMIN_PASSWORD=admin123

# Bộ nhận diện: mock (giả lập) | yolo (model thật)
DETECTOR=mock
# Đường dẫn model khi DETECTOR=yolo (.pt hoặc .onnx)
MODEL_PATH=models/best.pt
# Ngưỡng tin cậy: vật dưới ngưỡng bị coi là "không hợp lệ"
CONF_THRESHOLD=0.5

# Cổng chạy server
PORT=5000
