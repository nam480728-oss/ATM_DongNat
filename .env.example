# Kết nối MySQL/MariaDB (database atm_db)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/atm_db?charset=utf8mb4

# Khóa bí mật Flask (đổi thành chuỗi ngẫu nhiên)
SECRET_KEY=change-me

# Mật khẩu trang /admin
ADMIN_PASSWORD=admin123

# Bộ nhận diện: mock (giả lập theo đáp án 3D) | yolo (model thật). Đổi được lúc chạy ở panel Dev (phím ~)
DETECTOR=mock
# Model khi DETECTOR=yolo (YOLO11s lần 3, xem models/model/MODEL_CARD.md)
MODEL_PATH=models/model/best.pt
# Ngưỡng tin cậy model thật: chai/lon và rác (other)
CONF_BOTTLE_CAN=0.85
CONF_OTHER=0.80
# Cỡ ảnh đưa vào model khi quét cả khay
YOLO_IMGSZ=1280
# So nền khoang nạp: vùng có vật mà model không khoanh -> vật lạ -> báo động (1 bật, 0 tắt)
BG_CHECK=1
# Ngưỡng của bộ giả lập (mock)
CONF_THRESHOLD=0.5

# Khóa Roboflow (chỉ cần khi tải lại dữ liệu: models/scripts/Down_data/download_roboflow.py)
# ROBOFLOW_API_KEY=

# Cổng chạy server
PORT=5000

# Địa chỉ gắn vào mã QR voucher – điện thoại người bán phải mở được (vd http://192.168.1.10:5000).
# Để trống: lấy theo địa chỉ màn hình trạm đang dùng.
# PUBLIC_BASE_URL=
